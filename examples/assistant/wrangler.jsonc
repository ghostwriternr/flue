{
	// User-owned wrangler config for this Flue app. The official Cloudflare
	// Vite integration reads this file, applies Flue's contributions (via the
	// flueWorkerConfig() customizer in vite.config.ts), and emits the
	// deployable Worker output. flueWorkerConfig() adds the FLUE_SANDBOX
	// binding for the FlueSandbox container entry below.
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "assistant",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Sandbox"]
		},
		{
			"tag": "flue-class-Assistant",
			"new_sqlite_classes": ["Assistant"]
		},
		{
			"tag": "flue-class-FlueRegistry",
			"new_sqlite_classes": ["FlueRegistry"]
		},
		{
			"tag": "flue-rename-generated-classes",
			"renamed_classes": [{ "from": "Assistant", "to": "FlueAssistantAgent" }]
		},
		{
			// Workflows (and their run-pointer registry DO) were removed from
			// Flue; the generated Worker no longer exports FlueRegistry.
			"tag": "flue-remove-workflow-registry",
			"deleted_classes": ["FlueRegistry"]
		},
		{
			// The @cloudflare/sandbox 0.x Sandbox Durable Object is replaced by
			// FlueSandbox. Deploy this once at 100%.
			"tag": "flue-sandbox",
			"deleted_classes": ["Sandbox"],
			"new_sqlite_classes": ["FlueSandbox"]
		}
	],
	"containers": [
		{
			"class_name": "FlueSandbox",
			"name": "assistant-sandbox",
			"scheduling_policy": "durable_object",
			"images": {
				"default": { "dockerfile": "./Dockerfile" }
			}
		}
	]
}
